#!/usr/bin/env python3
"""Search local Claude Code sessions across all projects, grouped by chat.

In a terminal, results open in an fzf picker (arrows + Enter resumes the chat); --print prints them instead.

Examples:
  claude-search                            # switcher: pick a recent chat and resume it
  claude-search flaky test                 # sessions containing both "flaky" and "test"
  claude-search "flaky test"               # exact phrase
  claude-search -e 'PROJ-\\d+' --since 30d  # regex, last 30 days
  claude-search -t gradle -p myapp         # include tool calls/results, only projects matching "myapp"
  claude-search --print docker             # print grouped results with snippets instead of the picker
"""
import argparse
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

PROJECTS = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "projects"
HOME = str(Path.home())


# Readable on both light and dark backgrounds: no yellow/cyan (invisible on white) or blue (invisible on black).
# Override with e.g. CLAUDE_SEARCH_COLORS="hl=1;31:title=1:path=32:you=35:claude=2:dim=2"
COLORS = {"hl": "1;31", "title": "1", "path": "32", "you": "35", "claude": "2", "dim": "2"}


class Style:
    def __init__(self, on):
        codes = dict(COLORS)
        for item in os.environ.get("CLAUDE_SEARCH_COLORS", "").split(":"):
            k, _, v = item.partition("=")
            if k in codes:
                codes[k] = v
        for k, code in codes.items():
            setattr(self, k, (lambda s, code=code: f"\033[{code}m{s}\033[0m" if s else s) if on and code else (lambda s: s))


def light_background():
    # COLORFGBG is "fg;bg" (set by iTerm2, Terminal.app, rxvt, Konsole); bg 7 or 15 means a light theme.
    return os.environ.get("COLORFGBG", "").rsplit(";", 1)[-1] in ("7", "15")


def fmt_time(ts):
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")


def clip_path(p, width):
    p = short_path(p)
    return p if len(p) <= width else "…" + p[-(width - 1):]


def one_line(text, width=None):
    text = re.sub(r"\s+", " ", text or "").strip()
    return text if width is None or len(text) <= width else text[:width - 1] + "…"


MAX_PATH_WIDTH = 50  # project column; longer paths keep their tail ("…/project")
MIN_TITLE_WIDTH = 25
FZF_LIST_CHROME = 3  # columns fzf uses around list rows (pointer, marker, scrollbar)


def fmt_cost(cost):
    return "" if cost is None else f"${cost:,.2f}"


def model_name(model_id):
    """claude-opus-5-5 -> Opus 5.5, claude-haiku-4-5-20251001 -> Haiku 4.5"""
    m = re.fullmatch(r"claude-([a-z]+)((?:-\d{1,2})*)(?:-\d{8})?", model_id or "")
    if not m:
        return model_id or ""
    return f"{m[1].capitalize()} {m[2][1:].replace('-', '.')}".strip()


def stats_column(sessions):
    """Right-hand column: model used last and session cost, aligned across rows."""
    mw = max((len(model_name(s["model"])) for s in sessions), default=0)
    cw = max((len(fmt_cost(s["cost"])) for s in sessions), default=0)
    return lambda s: f"{model_name(s['model']).ljust(mw)}  {fmt_cost(s['cost']).rjust(cw)}", mw + 2 + cw


def visible_len(text):
    return len(re.sub(r"\033\[[0-9;]*m", "", text))


def right_align(left, right, width):
    """Pad `left` so `right` ends at column `width` (at least two spaces apart)."""
    return f"{left}{' ' * max(2, width - visible_len(left) - visible_len(right))}{right}"


def path_width(sessions, available):
    """Width of the project column: fit the longest path, within what the line has room for."""
    longest = max((len(short_path(s["cwd"])) for s in sessions), default=0)
    return min(longest, MAX_PATH_WIDTH, max(24, available - 18 - MIN_TITLE_WIDTH))  # 18 = timestamp + gaps


def page(lines):
    """Show output through a pager (like git) when writing to a terminal."""
    if not sys.stdout.isatty():
        print("\n".join(lines))
        return
    pager = os.environ.get("CLAUDE_SEARCH_PAGER") or os.environ.get("PAGER") or "less"
    env = dict(os.environ)
    env.setdefault("LESS", "FRX")  # quit if one screen, keep colors, don't clear the screen
    try:
        proc = subprocess.Popen(pager, shell=True, stdin=subprocess.PIPE, env=env, text=True)
    except OSError:
        print("\n".join(lines))
        return
    try:
        proc.stdin.write("\n".join(lines) + "\n")
        proc.stdin.close()
    except BrokenPipeError:  # user quit the pager early
        pass
    while True:
        try:
            proc.wait()
            break
        except KeyboardInterrupt:  # let less handle Ctrl-C itself
            pass


def parse_since(s):
    m = re.fullmatch(r"(\d+)([hdwm])", s)
    if m:
        n, unit = int(m[1]), m[2]
        return time.time() - n * {"h": 3600, "d": 86400, "w": 7 * 86400, "m": 30 * 86400}[unit]
    return datetime.fromisoformat(s).timestamp()


def short_path(p):
    return "~" + p[len(HOME):] if p and p.startswith(HOME) else p


def block_texts(rec, opts):
    """Yield (role, text) pairs for the searchable parts of a record."""
    t = rec.get("type")
    if t not in ("user", "assistant"):
        return
    content = (rec.get("message") or {}).get("content")
    if isinstance(content, str):
        content = [{"type": "text", "text": content}]
    if not isinstance(content, list):
        return
    for b in content:
        bt = b.get("type")
        if bt == "text":
            text = b.get("text", "")
            # Slash-command echoes, task notifications, skill bodies, caveats...
            if t == "user" and (rec.get("isMeta") or text.startswith("<")) and not opts.all:
                continue
            yield ("you" if t == "user" else "claude"), text
        elif bt == "thinking" and opts.all:
            yield "thinking", b.get("thinking", "")
        elif bt == "tool_use" and opts.tools:
            yield "tool", f"{b.get('name')}: {json.dumps(b.get('input'), ensure_ascii=False)}"
        elif bt == "tool_result" and opts.tools:
            c = b.get("content")
            if isinstance(c, list):
                c = "\n".join(x.get("text", "") for x in c if isinstance(x, dict))
            yield "result", c or ""


def highlight(text, patterns, st):
    """Highlight every match of any pattern; overlapping matches are merged."""
    spans = sorted(m.span() for p in patterns for m in p.finditer(text) if m.end() > m.start())
    out, pos = [], 0
    for a, b in spans:
        if b <= pos:
            continue
        a = max(a, pos)
        out += [text[pos:a], st.hl(text[a:b])]
        pos = b
    return "".join(out) + text[pos:]


def snippet(text, m, width, st, patterns=()):
    a, b = m.span()
    lead = "…" if a - width > 0 else ""
    tail = "…" if b + width < len(text) else ""
    window = one_line(text[max(0, a - width):b + width])
    if any(p.search(window) for p in patterns):  # may not, e.g. a regex spanning collapsed whitespace
        return f"{lead}{highlight(window, patterns, st)}{tail}"
    pre = re.sub(r"\s+", " ", text[max(0, a - width):a]).lstrip()
    post = re.sub(r"\s+", " ", text[b:b + width]).rstrip()
    return f"{lead}{pre}{st.hl(re.sub(r'\s+', ' ', m.group()))}{post}{tail}"


def last_activity(path):
    """Timestamp of the last record in the file (mtime is unreliable: syncs/migrations touch files)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 256 * 1024))
            stamps = re.findall(rb'"timestamp":"([^"]+)"', f.read())
        if stamps:
            return datetime.fromisoformat(stamps[-1].decode().replace("Z", "+00:00")).timestamp()
    except (OSError, ValueError):
        pass
    return path.stat().st_mtime


def search_file(path, opts, patterns, literals):
    """Return a session dict if every pattern matches somewhere in the file, else None."""
    titles = {}
    hits = []  # (timestamp, role, text, match)
    matched = [False] * len(patterns)
    meta = {"cwd": None, "branch": None, "first_prompt": None, "last_prompt": None, "cost": None}
    models = []  # in order of first use; the last element is the model used most recently
    try:
        f = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return None
    with f:
        for line in f:
            if '"type":"ai-title"' in line or '"type":"custom-title"' in line:
                try:
                    r = json.loads(line)
                    if r.get("aiTitle"):
                        titles["ai"] = r["aiTitle"]
                    if r.get("customTitle"):
                        titles["custom"] = r["customTitle"]
                except ValueError:
                    pass
                continue
            i = line.find('"message":{"model":"')
            if i >= 0:
                i += 20
                model = line[i:line.find('"', i)]
                if model.startswith("claude-") and (not models or models[-1] != model):
                    if model in models:
                        models.remove(model)
                    models.append(model)
            if '"type":"cost-state"' in line:  # cumulative, so the last one is the session total
                try:
                    meta["cost"] = json.loads(line).get("totalCostUSD", meta["cost"])
                except ValueError:
                    pass
                continue
            if '"type":"last-prompt"' in line:
                try:
                    meta["last_prompt"] = json.loads(line).get("lastPrompt") or meta["last_prompt"]
                except ValueError:
                    pass
                continue
            need_meta = meta["cwd"] is None or meta["first_prompt"] is None
            # Cheap prefilter on the raw JSON line; skip when the literal could be JSON-escaped.
            if not need_meta and literals is not None:
                low = line.lower() if opts.ignore_case else line
                if not any(l in low for l in literals):
                    continue
            if '"type":"user"' not in line and '"type":"assistant"' not in line:
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if meta["cwd"] is None and rec.get("cwd"):
                meta["cwd"], meta["branch"] = rec["cwd"], rec.get("gitBranch")
            for role, text in block_texts(rec, opts):
                if meta["first_prompt"] is None and role == "you" and text.strip():
                    meta["first_prompt"] = text
                first = None
                for i, p in enumerate(patterns):
                    m = p.search(text)
                    if m:
                        matched[i] = True
                        first = first or m
                if first:  # one hit per block is enough
                    hits.append((rec.get("timestamp", ""), role, text, first))

    if not patterns and not titles and meta["first_prompt"] is None:
        return None  # empty session (e.g. opened and closed, or only slash commands)
    title = titles.get("custom") or titles.get("ai") or one_line(meta["first_prompt"] or "(untitled)", 80)
    for i, p in enumerate(patterns):
        if not matched[i] and p.search(title):
            matched[i] = True
    if not all(matched):
        return None
    sid = path.stem
    if path.parent.name == "subagents":
        sid = path.parent.parent.name  # attribute subagent transcripts to their parent session
    return {
        "id": sid,
        "file": str(path),
        "subagent": path.parent.name == "subagents",
        "title": title,
        "cwd": meta["cwd"] or "/" + path.parts[len(PROJECTS.parts)].lstrip("-").replace("-", "/"),
        "branch": meta["branch"],
        "first_prompt": meta["first_prompt"],
        "last_prompt": meta["last_prompt"],
        "cost": meta["cost"],
        "model": models[-1] if models else None,
        "models": models,
        "mtime": last_activity(path),
        "hits": hits,
    }


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("terms", nargs="*", help="search terms; a session must contain all of them (quote for a phrase). "
                                             "Without terms, list recent chats")
    ap.add_argument("-e", "--regex", action="store_true", help="treat terms as regular expressions")
    ap.add_argument("-s", "--case-sensitive", dest="ignore_case", action="store_false")
    ap.add_argument("-t", "--tools", action="store_true", help="also search tool calls and tool output")
    ap.add_argument("-a", "--all", action="store_true", help="search everything: tools, thinking, command/system messages")
    ap.add_argument("--subagents", action="store_true", help="also search subagent transcripts")
    ap.add_argument("-p", "--project", help="only projects whose path contains this substring")
    ap.add_argument("--since", help="only sessions active since e.g. 12h, 7d, 2w, 3m or 2026-10-01")
    ap.add_argument("-n", "--snippets", type=int, default=3, help="snippets per session (default 3, 0 = none)")
    ap.add_argument("-w", "--width", type=int, default=70, help="context characters around each match")
    ap.add_argument("--sort", choices=["recent", "hits"], default="recent")
    ap.add_argument("-l", "--limit", type=int, default=0, help="max sessions to show")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--print", dest="print_list", action="store_true", help="print results instead of opening the fzf picker")
    ap.add_argument("-i", "--interactive", action="store_true", help=argparse.SUPPRESS)  # old flag; the picker is now the default
    ap.add_argument("--no-pager", action="store_true", help="don't page output")
    opts = ap.parse_args()
    if opts.all:
        opts.tools = True
    recent_mode = not opts.terms
    if opts.no_pager:
        os.environ["CLAUDE_SEARCH_PAGER"] = "cat"

    flags = re.IGNORECASE if opts.ignore_case else 0
    srcs = opts.terms if opts.regex else [re.escape(t) for t in opts.terms]
    try:
        patterns = [re.compile(s, flags) for s in srcs]
    except re.error as e:
        sys.exit(f"bad regex: {e}")
    opts.patterns = patterns
    literals = None
    if not opts.regex and all(t.isprintable() and '"' not in t and "\\" not in t for t in opts.terms):
        literals = [t.lower() if opts.ignore_case else t for t in opts.terms]

    since = parse_since(opts.since) if opts.since else None
    files = list(PROJECTS.glob("*/*.jsonl"))
    if opts.subagents and not recent_mode:
        files += PROJECTS.glob("*/*/subagents/*.jsonl")
    # Project dirs are the cwd with every non-alphanumeric char replaced by "-".
    proj_key = re.sub(r"[^a-z0-9]", "-", opts.project.lower()) if opts.project else None

    results = {}
    for path in files:
        try:
            # mtime is never earlier than the last record, so it's a safe prefilter
            if since and path.stat().st_mtime < since:
                continue
        except OSError:
            continue
        if proj_key and proj_key not in path.parts[len(PROJECTS.parts)].lower():
            continue
        s = search_file(path, opts, patterns, literals)
        if not s or (since and s["mtime"] < since):
            continue
        if s["id"] in results:  # merge subagent hits into the parent session
            prev = results[s["id"]]
            prev["hits"] += s["hits"]
            prev["mtime"] = max(prev["mtime"], s["mtime"])
            if prev["subagent"] and not s["subagent"]:
                prev.update({k: s[k] for k in ("title", "cwd", "branch", "file", "first_prompt", "last_prompt", "cost",
                                                       "model", "models")},
                            subagent=False)
        else:
            results[s["id"]] = s

    sessions = sorted(results.values(), key=(lambda s: len(s["hits"])) if opts.sort == "hits" else (lambda s: s["mtime"]), reverse=True)
    if opts.limit:
        sessions = sessions[:opts.limit]

    if opts.json:
        out = [{k: v for k, v in s.items() if k not in ("hits", "mtime")} | {
            "last_active": datetime.fromtimestamp(s["mtime"]).astimezone().isoformat(timespec="seconds"),
            "cost_usd": s["cost"],
            "model": s["model"],
            "models": s["models"],
            "resume": f"cd {s['cwd']!r} && claude --resume {s['id']}",
        } | ({} if recent_mode else {
            "hit_count": len(s["hits"]),
            "snippets": [{"role": r, "timestamp": ts, "text": snippet(t, m, opts.width, Style(False))} for ts, r, t, m in s["hits"][:opts.snippets]],
        }) for s in sessions]
        json.dump(out, sys.stdout, indent=2, ensure_ascii=False)
        print()
        return

    if not opts.print_list and sys.stdin.isatty() and sys.stdout.isatty() and shutil.which("fzf"):
        return pick(sessions, opts, recent_mode)

    st = Style(sys.stdout.isatty() and not os.environ.get("NO_COLOR"))
    paging = sys.stdout.isatty()
    lines = []
    if recent_mode:
        stats, cw = stats_column(sessions)
        if sys.stdout.isatty():
            cols = shutil.get_terminal_size().columns
            pw = path_width(sessions, cols)
            tw = max(MIN_TITLE_WIDTH, cols - 18 - pw - 2 - cw - 2 - 36)  # 36 = session id
        else:  # piped: keep full paths and titles, just align the columns
            pw = max((len(short_path(s["cwd"])) for s in sessions), default=0)
            tw = max((len(one_line(s["title"])) for s in sessions), default=0)
            cols = 18 + pw + 2 + tw + 2 + cw + 2 + 36
        for s in sessions:
            left = f"{st.dim(fmt_time(s['mtime']))}  {st.path(clip_path(s['cwd'], pw).ljust(pw))}  {st.title(one_line(s['title'], tw))}"
            lines.append(right_align(left, f"{stats(s)}  {st.dim(s['id'])}", cols))
        summary = f"{len(sessions)} session(s)"
    else:
        for s in sessions:
            n = len(s["hits"])
            info = " · ".join(x for x in (f"{n} hit{'s' if n != 1 else ''}", fmt_time(s["mtime"]),
                                          model_name(s["model"]), fmt_cost(s["cost"])) if x)
            lines.append(f"{st.title(s['title'])}  {st.dim(info)}")
            branch = f" ({s['branch']})" if s["branch"] and s["branch"] != "HEAD" else ""
            lines.append(f"  {st.path(short_path(s['cwd']))}{st.dim(branch)}")
            for ts, role, text, m in s["hits"][:opts.snippets]:
                label = getattr(st, role, st.dim)(f"{role:>8}")
                lines.append(f"  {label} {snippet(text, m, opts.width, st, opts.patterns)}")
            if n > opts.snippets > 0:
                lines.append(st.dim(f"           … {n - opts.snippets} more"))
            lines.append(st.dim(f"  ↳ cd {short_path(s['cwd'])} && claude --resume {s['id']}"))
            lines.append("")
        summary = f"{len(sessions)} session(s), {sum(len(s['hits']) for s in sessions)} hit(s)"
    if paging:
        page([st.dim(summary), ""] + lines)
    else:
        print("\n".join(lines))
        print(summary, file=sys.stderr)


def pick(sessions, opts, recent_mode):
    if not sessions:
        sys.exit("no matches")
    if not shutil.which("fzf"):
        sys.exit("fzf not found; install it or use --print")
    st = Style(not os.environ.get("NO_COLOR"))
    list_width = shutil.get_terminal_size().columns  # preview sits below, so the list gets the full width
    stats, cw = stats_column(sessions)
    row_width = list_width - FZF_LIST_CHROME
    pw = path_width(sessions, row_width - (cw + 2) - (0 if recent_mode else 6))  # "(hits)"
    # Make kill / closing the terminal unwind through `finally`, so the preview dir is removed.
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, frame: sys.exit(128 + signum))
    # Previews go to files so they can be colored, and the input lines stay small.
    tmp = tempfile.mkdtemp(prefix="claude-search-")
    try:
        lines = []
        for idx, s in enumerate(sessions):
            branch = f" ({s['branch']})" if s["branch"] and s["branch"] != "HEAD" else ""
            preview = [st.title(s["title"]), st.path(short_path(s["cwd"])) + st.dim(branch),
                       st.dim(f"last active {fmt_time(s['mtime'])}")]
            if s["models"]:
                preview.append(st.dim("model" + ("s" if len(s["models"]) > 1 else "") + ": " +
                                      " → ".join(model_name(m) for m in s["models"])))
            preview.append("")
            if recent_mode:
                preview += [st.you("First prompt:"), one_line(s["first_prompt"], 600), ""]
                if s["last_prompt"] and one_line(s["last_prompt"]) != one_line(s["first_prompt"]):
                    preview += [st.you("Last prompt:"), one_line(s["last_prompt"], 600), ""]
            else:
                for _, role, text, m in s["hits"][:50]:
                    label = getattr(st, role, st.dim)(f"{role}:")
                    preview += [f"{label} {snippet(text, m, opts.width * 2, st, opts.patterns)}", ""]
                if len(s["hits"]) > 50:
                    preview += [st.dim(f"… {len(s['hits']) - 50} more"), ""]
            preview.append(st.dim(f"cd {short_path(s['cwd'])} && claude --resume {s['id']}"))
            Path(tmp, str(idx)).write_text("\n".join(preview) + "\n", encoding="utf-8")
            hits = "" if recent_mode else "  " + st.dim(f"({len(s['hits'])})")
            row = f"{st.dim(fmt_time(s['mtime']))}  {st.path(clip_path(s['cwd'], pw).ljust(pw))}  "
            row += one_line(s["title"], max(10, row_width - visible_len(row) - visible_len(hits) - cw - 2)) + hits
            # Model/cost is a separate field pinned with --freeze-right, so a long title is truncated instead.
            right = stats(s)
            lines.append(f"{idx}\t{row}{' ' * max(1, row_width - visible_len(row) - len(right) - 1)}\t{right}")
        n = len(sessions)
        what = "recent chats" if recent_mode else \
            f"{n} chat{'s' if n != 1 else ''} matching " + " ".join(shlex.quote(t) for t in opts.terms)
        header = f"{what} · type to filter · Enter: resume · Esc: quit"
        # --exact: the filter matches substrings; fuzzy matching hits most titles for any word
        cmd = ["fzf", "--ansi", "--exact", "--delimiter", "\t", "--with-nth", "2,3", "--freeze-right", "1", "--tabstop", "1",
               "--no-sort", "--layout", "reverse",
               "--prompt", "Filter: ", "--header", header,
               "--preview-window", "down,40%,wrap",
               "--preview", f"cat {shlex.quote(tmp)}/{{1}}"]
        if light_background() and "--color" not in os.environ.get("FZF_DEFAULT_OPTS", ""):
            cmd += ["--color", "light"]
        res = subprocess.run(cmd, input="\n".join(lines), stdout=subprocess.PIPE, text=True)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    if res.returncode != 0 or not res.stdout.strip():
        return
    s = sessions[int(res.stdout.split("\t", 1)[0])]
    if not os.path.isdir(s["cwd"]):
        sys.exit(f"project dir no longer exists: {s['cwd']}")
    print(f"cd {short_path(s['cwd'])} && claude --resume {s['id']}", file=sys.stderr)
    os.chdir(s["cwd"])
    os.execvp("claude", ["claude", "--resume", s["id"]])


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
